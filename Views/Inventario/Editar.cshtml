@model ProyectoConexionRed.Web.Models.EditarEquipoViewModel
@{
    ViewData["Title"] = "Editar equipo";
}
<section class="panel-formulario panel-formulario-ancho">
    <p class="sobrelinea">Inventario documental</p>
    <h1>Editar equipo</h1>
    <p>Los cambios actualizan la ficha guardada y quedan registrados en el historial. No configuran el equipo real.</p>
    <form asp-action="Editar" method="post">
        <input asp-for="Identificador" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="mensaje-error"></div>
        <div class="rejilla-formulario">
            <div><label asp-for="Nombre">Nombre</label><input asp-for="Nombre" /><span asp-validation-for="Nombre" class="mensaje-error"></span></div>
            <div><label asp-for="Fabricante">Fabricante</label><input asp-for="Fabricante" /><span asp-validation-for="Fabricante" class="mensaje-error"></span></div>
            <div><label asp-for="Modelo">Modelo</label><input asp-for="Modelo" /><span asp-validation-for="Modelo" class="mensaje-error"></span></div>
            <div><label asp-for="IpAdministracion">IP documentada</label><input asp-for="IpAdministracion" /><span asp-validation-for="IpAdministracion" class="mensaje-error"></span></div>
            <div><label asp-for="DireccionMac">Dirección MAC</label><input asp-for="DireccionMac" /><span asp-validation-for="DireccionMac" class="mensaje-error"></span></div>
            <div><label asp-for="Area">Área</label><input asp-for="Area" /><span asp-validation-for="Area" class="mensaje-error"></span></div>
            <div><label asp-for="Piso">Piso o sector físico</label><input asp-for="Piso" /><span asp-validation-for="Piso" class="mensaje-error"></span></div>
            <div><label asp-for="RolEnArea">Función del equipo</label><select asp-for="RolEnArea"><option>No indicado</option><option>Switch de área</option><option>Switch de servidores</option><option>Distribución de switches de área</option><option>Puente hacia Dell R770 principal previsto</option><option>Principal</option><option>No principal</option><option>Secundario</option><option>Reserva</option><option>No aplica</option></select><small>Describe para qué se usa el equipo; fabricante y modelo se registran por separado.</small><span asp-validation-for="RolEnArea" class="mensaje-error"></span></div>
            <div><label asp-for="TipoDispositivo">Tipo de dispositivo</label><select asp-for="TipoDispositivo"><option>Puesto de usuario</option><option>Switch</option><option>Equipo de red</option><option>Router</option><option>Firewall</option><option>UPS</option><option>Servidor</option><option>No especificado</option><option>Impresora</option><option>No especificado</option><option>Otro</option></select><span asp-validation-for="TipoDispositivo" class="mensaje-error"></span></div>
            <div class="grupo-capacidades-switch" data-capacidades-switch hidden>
                <p class="nota-capacidades-switch">Cantidad de conectores físicos. Si el modelo no tiene perfil exacto, estos valores dibujan sus posiciones; 0 significa ninguno y vacío, cantidad desconocida.</p>
                <div><label asp-for="CantidadPuertosRj45">Puertos RJ45</label><input asp-for="CantidadPuertosRj45" type="number" min="0" max="512" /><span asp-validation-for="CantidadPuertosRj45" class="mensaje-error"></span></div>
                <div><label asp-for="CantidadPuertosSfp">Puertos SFP</label><input asp-for="CantidadPuertosSfp" type="number" min="0" max="512" /><span asp-validation-for="CantidadPuertosSfp" class="mensaje-error"></span></div>
                <div><label asp-for="CantidadPuertosSfpPlus">Puertos SFP+</label><input asp-for="CantidadPuertosSfpPlus" type="number" min="0" max="512" /><span asp-validation-for="CantidadPuertosSfpPlus" class="mensaje-error"></span></div>
                <div><label asp-for="CantidadPuertosQsfp">Puertos QSFP</label><input asp-for="CantidadPuertosQsfp" type="number" min="0" max="512" /><span asp-validation-for="CantidadPuertosQsfp" class="mensaje-error"></span></div>
                <div><label asp-for="CantidadPuertosQsfpPlus">Puertos QSFP+</label><input asp-for="CantidadPuertosQsfpPlus" type="number" min="0" max="512" /><span asp-validation-for="CantidadPuertosQsfpPlus" class="mensaje-error"></span></div>
                <div><label asp-for="CantidadPuertosQsfp28">Puertos QSFP28</label><input asp-for="CantidadPuertosQsfp28" type="number" min="0" max="512" /><span asp-validation-for="CantidadPuertosQsfp28" class="mensaje-error"></span></div>
            </div>
            <div><label asp-for="EstadoDatos">Vigencia de los datos</label><select asp-for="EstadoDatos"><option>Vigente</option><option>Pendiente de validación</option><option>A verificar</option><option>Desactualizado</option><option>Confirmado</option></select><span asp-validation-for="EstadoDatos" class="mensaje-error"></span></div>
            <div><label asp-for="FechaUltimaRevision">Última revisión real</label><input asp-for="FechaUltimaRevision" type="date" /><span asp-validation-for="FechaUltimaRevision" class="mensaje-error"></span></div>
            <div class="campo-completo"><label asp-for="Observaciones">Observaciones</label><textarea asp-for="Observaciones" rows="4"></textarea><span asp-validation-for="Observaciones" class="mensaje-error"></span></div>
        </div>
        <div class="acciones-formulario">
            <button class="boton-principal" type="submit">Guardar cambios</button>
            <a asp-action="Index">Volver al inventario</a>
        </div>
    </form>
</section>

<script src="~/js/capacidades-switch.js" asp-append-version="true"></script>
