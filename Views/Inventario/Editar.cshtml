@model ProyectoConexionRed.Web.Models.EditarEquipoViewModel
@{
    ViewData["Title"] = "Editar equipo";
}
<section class="panel-formulario panel-formulario-ancho">
    <p class="sobrelinea">Inventario documental</p>
    <h1>Editar equipo</h1>
    <p>Los cambios actualizan la ficha guardada y quedan registrados en el historial. No configuran el equipo real.</p>
    <form asp-action="Editar" method="post">
        <input asp-for="Identificador" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="mensaje-error"></div>
        <div class="rejilla-formulario">
            <div><label asp-for="Nombre">Nombre</label><input asp-for="Nombre" /><span asp-validation-for="Nombre" class="mensaje-error"></span></div>
            <div><label asp-for="Fabricante">Fabricante</label><input asp-for="Fabricante" /><span asp-validation-for="Fabricante" class="mensaje-error"></span></div>
            <div><label asp-for="Modelo">Modelo</label><input asp-for="Modelo" /><span asp-validation-for="Modelo" class="mensaje-error"></span></div>
            <div><label asp-for="IpAdministracion">IP documentada</label><input asp-for="IpAdministracion" /><span asp-validation-for="IpAdministracion" class="mensaje-error"></span></div>
            <div><label asp-for="DireccionMac">Dirección MAC</label><input asp-for="DireccionMac" /><span asp-validation-for="DireccionMac" class="mensaje-error"></span></div>
            <div><label asp-for="Area">Área</label><input asp-for="Area" /><span asp-validation-for="Area" class="mensaje-error"></span></div>
            <div><label asp-for="Piso">Piso o sector físico</label><input asp-for="Piso" /><span asp-validation-for="Piso" class="mensaje-error"></span></div>
            <div><label asp-for="RolEnArea">Rol en el área</label><select asp-for="RolEnArea"><option>No indicado</option><option>Principal</option><option>No principal</option><option>Secundario</option><option>Reserva</option><option>No aplica</option></select><span asp-validation-for="RolEnArea" class="mensaje-error"></span></div>
            <div><label asp-for="TipoDispositivo">Tipo de dispositivo</label><select asp-for="TipoDispositivo"><option>Puesto de usuario</option><option>Switch</option><option>Equipo de red</option><option>Router</option><option>Firewall</option><option>UPS</option><option>Servidor</option><option>No especificado</option><option>Otro</option></select><span asp-validation-for="TipoDispositivo" class="mensaje-error"></span></div>
            <div><label asp-for="EstadoDatos">Vigencia de los datos</label><select asp-for="EstadoDatos"><option>Vigente</option><option>Pendiente de validación</option><option>A verificar</option><option>Desactualizado</option><option>Confirmado</option></select><span asp-validation-for="EstadoDatos" class="mensaje-error"></span></div>
            <div><label asp-for="FechaUltimaRevision">Última revisión real</label><input asp-for="FechaUltimaRevision" type="date" /><span asp-validation-for="FechaUltimaRevision" class="mensaje-error"></span></div>
            <div class="campo-completo"><label asp-for="Observaciones">Observaciones</label><textarea asp-for="Observaciones" rows="4"></textarea><span asp-validation-for="Observaciones" class="mensaje-error"></span></div>
        </div>
        <div class="acciones-formulario">
            <button class="boton-principal" type="submit">Guardar cambios</button>
            <a asp-action="Index">Volver al inventario</a>
        </div>
    </form>
</section>
