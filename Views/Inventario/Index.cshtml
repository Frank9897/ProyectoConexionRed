@model IReadOnlyList<EquipoRed>
@{
    ViewData["Title"] = "Inventario";
}

<section class="encabezado-pagina">
    <div>
        <p class="sobrelinea">EQUIPOS DOCUMENTADOS</p>
        <h1>Inventario</h1>
        <p>Consulta equipos e IP confirmados. El estado administrativo no representa disponibilidad de red.</p>
    </div>
</section>

<form method="get" class="busqueda">
    <label for="busqueda">Buscar por equipo, IP, área, modelo o fabricante</label>
    <div class="fila-busqueda">
        <input id="busqueda" name="busqueda" value="@Context.Request.Query["busqueda"]" placeholder="Ej.: 192.168.1.44 o Agrimensura" />
        <button class="boton" type="submit">Buscar</button>
        <a class="boton boton-secundario" asp-controller="Inventario" asp-action="Index">Limpiar</a>
    </div>
</form>

<div class="resumen">
    <span>@Model.Count equipos mostrados</span>
    <span>Datos de equipos e IP confirmados por el usuario</span>
</div>

<div class="tabla-contenedor">
    <table>
        <thead>
            <tr>
                <th>Equipo</th>
                <th>Fabricante / modelo</th>
                <th>Área</th>
                <th>IP de administración</th>
                <th>Rol</th>
                <th>Acceso administrativo</th>
                <th>Vigencia</th>
            </tr>
        </thead>
        <tbody>
        @* equipo representa cada fila del modelo; cambiar el modelo de entrada cambia los equipos visibles. *@
        @foreach (var equipo in Model)
        {
            <tr>
                <td>
                    <strong>@equipo.Nombre</strong>
                    @if (!string.IsNullOrWhiteSpace(equipo.Observaciones))
                    {
                        <small>@equipo.Observaciones</small>
                    }
                </td>
                <td>@(equipo.Fabricante ?? "—")<br /><small>@(equipo.Modelo ?? "Modelo no indicado")</small></td>
                <td>@(equipo.Area ?? "—")</td>
                <td><span class="ip">@(equipo.IpAdministracion ?? "No indicada")</span></td>
                <td>@equipo.RolEnArea</td>
                <td><span class="estado @(equipo.EstadoAdministrativo.StartsWith("Inaccesible") ? "estado-alerta" : "")">@equipo.EstadoAdministrativo</span></td>
                <td><span class="estado estado-vigente">@equipo.EstadoDatos</span></td>
            </tr>
        }
        </tbody>
    </table>
</div>
