<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoConexionRed</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="barra-superior">
        <a class="marca" asp-controller="Home" asp-action="Index">ProyectoConexionRed</a>
        @*
        MODO TEMPORAL SIN LOGIN.
        Se conserva comentada la navegación que dependía de una sesión.
        Al restaurar el login, reemplaza la navegación pública con este bloque.

        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav aria-label="Navegación principal">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <a asp-controller="Inventario" asp-action="Index">Inventario</a>
                <a asp-controller="Topologia" asp-action="Index">Topología</a>
                <a asp-controller="Cambios" asp-action="Index">Cambios</a>
                <a asp-controller="Auditoria" asp-action="Index">Accesos</a>
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                }
                <span class="usuario-actual">@(User.Identity?.Name ?? "Cuenta")</span>
                <form asp-controller="Cuenta" asp-action="Salir" method="post" class="formulario-salida">
                    <button class="enlace-salida" type="submit">Cerrar sesión</button>
                </form>
            </nav>
        }
        *@
        @* La navegación de usuarios y el cierre quedan ocultos mientras el acceso está deshabilitado. *@
        <nav aria-label="Navegación principal">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <a asp-controller="Inventario" asp-action="Index">Inventario</a>
            <a asp-controller="Topologia" asp-action="Index">Topología</a>
            <a asp-controller="Cambios" asp-action="Index">Cambios</a>
        </nav>
    </header>
    <main class="contenedor">
        @RenderBody()
    </main>
    <footer class="pie">
        Inventario documental de red · Los cambios aquí no configuran equipos reales.
    </footer>
</body>
</html>
