@model ProyectoConexionRed.Web.Models.ConexionesIndexViewModel
@{
    ViewData["Title"] = "Puertos y enlaces";
}

<section class="encabezado-pagina encabezado-conexiones">
    <div>
        <p class="sobrelinea">DATOS PARA LA TOPOLOGÍA</p>
        <h1>Puertos y enlaces</h1>
        <p>Consulta las conexiones documentadas en fichas claras y compactas.</p>
    </div>
    <div class="acciones-encabezado-conexiones">
        <a class="boton boton-secundario" asp-action="CrearInterfaz">Registrar puerto</a>
        <a class="boton" asp-action="CrearEnlace">Registrar enlace entre puertos</a>
        <a class="boton boton-secundario" asp-action="CrearRelacion">Registrar conexión con extremo pendiente</a>
    </div>
</section>

@* mensajeConexiones informa el resultado de la última operación; cambiarlo altera el aviso temporal visible. *@
@if (TempData["Mensaje"] is string mensajeConexiones)
{
    <p class="mensaje-exito" role="status">@mensajeConexiones</p>
}

<section class="panel panel-conexiones seccion-registros" data-paginador="interfaces" aria-labelledby="titulo-interfaces">
    <div class="cabecera-listado-conexiones">
        <div>
            <p class="sobrelinea">EQUIPOS Y PUERTOS</p>
            <h2 id="titulo-interfaces">Interfaces registradas <span class="contador-enlaces">@Model.Interfaces.Count</span></h2>
        </div>
        <div class="controles-paginacion">
            <label for="tamano-interfaces">Mostrar</label>
            <select id="tamano-interfaces" data-tamano-pagina aria-label="Cantidad de interfaces por página">
                <option value="10" selected>10</option><option value="20">20</option><option value="30">30</option><option value="0">Todas</option>
            </select>
            <span data-resumen-pagina aria-live="polite"></span>
            <button class="boton-paginacion" type="button" data-pagina-anterior aria-label="Mostrar la página anterior">← Anterior</button>
            <button class="boton-paginacion" type="button" data-pagina-siguiente aria-label="Mostrar la página siguiente">Siguiente →</button>
        </div>
    </div>
    @if (Model.Interfaces.Count == 0)
    {
        <div class="estado-vacio-conexiones"><strong>Todavía no hay puertos documentados</strong><p>Agrega los puertos de los equipos antes de registrar conexiones entre ellos.</p></div>
    }
    else
    {
        <div class="lista-fichas-conexion" data-lista-paginada>
            @* interfaz recorre cada puerto; cambiar Model.Interfaces modifica las fichas disponibles. *@
            @foreach (var interfaz in Model.Interfaces)
            {
                <article class="ficha-conexion ficha-interfaz" data-registro-paginable>
                    <div class="cabecera-ficha-conexion">
                        <div><p class="identificador-secundario">@(interfaz.IpAdministracion ?? "IP no indicada")</p><h3>@interfaz.Equipo <span>· Puerto @interfaz.Puerto</span></h3></div>
                        <span class="etiqueta-estado-conexion">@interfaz.EstadoDatos</span>
                    </div>
                    <dl class="datos-ficha-conexion">
                        <div><dt>Tipo</dt><dd>@interfaz.Tipo</dd></div>
                        <div><dt>Uso</dt><dd>@interfaz.EstadoUso</dd></div>
                        <div><dt>Última revisión</dt><dd>@(interfaz.FechaUltimaRevision?.ToString("dd/MM/yyyy") ?? "Sin fecha confirmada")</dd></div>
                        <div class="dato-ficha-ancho"><dt>Observaciones</dt><dd>@(interfaz.Observaciones ?? "Sin observaciones")</dd></div>
                    </dl>
                    <div class="acciones-ficha-conexion">
                        <a class="boton boton-secundario" asp-controller="Correcciones" asp-action="EditarInterfaz" asp-route-identificador="@interfaz.Identificador">Corregir puerto</a>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="panel panel-conexiones seccion-registros" data-paginador="enlaces" aria-labelledby="titulo-enlaces">
    <div class="cabecera-listado-conexiones">
        <div>
            <p class="sobrelinea">RELACIONES ENTRE PUERTOS</p>
            <h2 id="titulo-enlaces">Enlaces físicos <span class="contador-enlaces">@Model.Enlaces.Count</span></h2>
        </div>
        <div class="controles-paginacion">
            <label for="tamano-enlaces">Mostrar</label>
            <select id="tamano-enlaces" data-tamano-pagina aria-label="Cantidad de enlaces por página">
                <option value="10" selected>10</option><option value="20">20</option><option value="30">30</option><option value="0">Todos</option>
            </select>
            <span data-resumen-pagina aria-live="polite"></span>
            <button class="boton-paginacion" type="button" data-pagina-anterior aria-label="Mostrar la página anterior">← Anterior</button>
            <button class="boton-paginacion" type="button" data-pagina-siguiente aria-label="Mostrar la página siguiente">Siguiente →</button>
        </div>
    </div>
    @if (Model.Enlaces.Count == 0)
    {
        <div class="estado-vacio-conexiones"><strong>Todavía no hay enlaces registrados</strong><p>Los enlaces documentados aquí podrán alimentar la vista de topología.</p></div>
    }
    else
    {
        <div class="lista-fichas-conexion" data-lista-paginada>
            @* enlace recorre cada conexión física; cambiar Model.Enlaces modifica las fichas disponibles. *@
            @foreach (var enlace in Model.Enlaces)
            {
                <article class="ficha-conexion ficha-enlace" data-registro-paginable>
                    <div class="trayecto-enlace">
                        <div class="extremo-enlace"><p class="identificador-secundario">ORIGEN</p><h3>@enlace.EquipoOrigen</h3><span>Puerto @enlace.PuertoOrigen</span></div>
                        <span class="flecha-enlace" aria-hidden="true">→</span>
                        <div class="extremo-enlace"><p class="identificador-secundario">DESTINO</p><h3>@enlace.EquipoDestino</h3><span>Puerto @enlace.PuertoDestino</span></div>
                        <span class="etiqueta-estado-conexion">@enlace.EstadoDatos</span>
                    </div>
                    <dl class="datos-ficha-conexion datos-enlace">
                        <div><dt>Medio</dt><dd>@enlace.Medio</dd></div>
                        <div><dt>Última revisión</dt><dd>@(enlace.FechaUltimaRevision?.ToString("dd/MM/yyyy") ?? "Sin fecha confirmada")</dd></div>
                        <div class="dato-ficha-ancho"><dt>Fuente</dt><dd>@(enlace.Fuente ?? "Sin fuente indicada")</dd></div>
                    </dl>
                    <div class="acciones-ficha-conexion">
                        <a class="boton boton-secundario" asp-controller="Correcciones" asp-action="EditarEnlace" asp-route-identificador="@enlace.Identificador">Corregir enlace</a>
                    </div>
                </article>
            }
        </div>
    }
</section>
<section class="panel panel-conexiones seccion-registros" data-paginador="relaciones-parciales" aria-labelledby="titulo-relaciones-parciales">
    <div class="cabecera-listado-conexiones">
        <div>
            <p class="sobrelinea">IMPORTACIÓN DOCUMENTAL</p>
            <h2 id="titulo-relaciones-parciales">Relaciones con extremo remoto pendiente <span class="contador-enlaces">@Model.RelacionesParciales.Count</span></h2>
        </div>
        <div class="controles-paginacion">
            <label for="tamano-relaciones-parciales">Mostrar</label>
            <select id="tamano-relaciones-parciales" data-tamano-pagina aria-label="Cantidad de relaciones parciales por página">
                <option value="10" selected>10</option><option value="20">20</option><option value="30">30</option><option value="0">Todas</option>
            </select>
            <span data-resumen-pagina aria-live="polite"></span>
            <button class="boton-paginacion" type="button" data-pagina-anterior aria-label="Mostrar página anterior">← Anterior</button>
            <button class="boton-paginacion" type="button" data-pagina-siguiente aria-label="Mostrar página siguiente">Siguiente →</button>
        </div>
    </div>
    @if (Model.RelacionesParciales.Count == 0)
    {
        <div class="estado-vacio-conexiones"><strong>No hay relaciones parciales</strong><p>Usa esta sección cuando una tabla identifique el puerto local pero no confirme el remoto.</p></div>
    }
    else
    {
        <div class="lista-fichas-conexion" data-lista-paginada>
            @* relacion recorre conexiones con puerto remoto opcional y conserva visible su procedencia. *@
            @foreach (var relacion in Model.RelacionesParciales)
            {
                <article class="ficha-conexion ficha-enlace" data-registro-paginable>
                    <div class="trayecto-enlace">
                        <div class="extremo-enlace"><p class="identificador-secundario">PUERTO LOCAL</p><h3>@relacion.EquipoLocal</h3><span>@relacion.PuertoLocal</span></div>
                        <span class="flecha-enlace" aria-hidden="true">→</span>
                        <div class="extremo-enlace"><p class="identificador-secundario">REMOTO DOCUMENTADO</p><h3>@(relacion.EquipoRemoto ?? "No identificado")</h3><span>@(relacion.PuertoRemoto ?? "Puerto no documentado") · @(relacion.IpRemota ?? "IP no indicada")</span></div>
                        <span class="etiqueta-estado-conexion">@relacion.EstadoDatos</span>
                    </div>
                    <dl class="datos-ficha-conexion datos-enlace">
                        <div><dt>Medio</dt><dd>@relacion.Medio</dd></div>
                        <div><dt>Página</dt><dd>@relacion.FuentePagina</dd></div>
                        <div><dt>Libro</dt><dd>@(relacion.FuenteLibro ?? "No indicado")</dd></div>
                        <div><dt>Fila</dt><dd>@(relacion.FuenteFila ?? "No indicada")</dd></div>
                        <div class="dato-ficha-ancho"><dt>Notas</dt><dd>@(relacion.Observaciones ?? "Sin observaciones")</dd></div>
                    </dl>
                </article>
            }
        </div>
    }
</section>
<script src="~/js/paginacion-conexiones.js" asp-append-version="true"></script>
