@model ProyectoConexionRed.Web.Models.ConexionesIndexViewModel
@{
    ViewData["Title"] = "Puertos";
}

<section class="encabezado-pagina encabezado-conexiones">
    <div>
        <p class="sobrelinea">ADMINISTRACIÓN DOCUMENTAL DE PUERTOS</p>
        <h1>Puertos</h1>
        <p>Elige un switch para revisar y editar su frontal. Los estados reflejan el inventario guardado, no consultas en vivo.</p>
    </div>
    <div class="acciones-encabezado-conexiones">
        <a class="boton boton-secundario" asp-action="CrearEnlace">Registrar enlace entre switches</a>
    </div>
</section>

@* mensajeConexiones comunica el resultado de una edición o alta anterior. *@
@if (TempData["Mensaje"] is string mensajeConexiones)
{
    <p class="mensaje-exito" role="status">@mensajeConexiones</p>
}
@if (TempData["Error"] is string errorConexiones)
{
    <p class="mensaje-error" role="alert">@errorConexiones</p>
}

@if (Model.Switches.Count == 0)
{
    <section class="panel estado-vacio-conexiones">
        <strong>No hay switches registrados en este inventario</strong>
        <p>Agrega un equipo con tipo Switch en Inventario y aparecerá aquí para completar sus puertos.</p>
        <a class="boton" asp-controller="Inventario" asp-action="Crear">Agregar switch</a>
    </section>
}
else
{
    <section class="switches-puertos-grid" aria-label="Switches disponibles">
        @* switchResumen representa cada switch y los extremos documentados que llegan a sus puertos. *@
        @foreach (var switchResumen in Model.Switches)
        {
            <article class="panel switch-puertos-card">
                <header>
                    <p class="sobrelinea">@(switchResumen.Area ?? "Área no indicada") · Switch</p>
                    <h2>@switchResumen.Nombre</h2>
                    <p class="detalle-switch-puertos">@(switchResumen.Modelo ?? "Modelo no indicado") · IP @(switchResumen.IpAdministracion ?? "No indicada")</p>
                </header>
                <div class="resumen-estado-switch-puertos" aria-label="Estado de interfaces inventariadas">
                    <span><i class="indicador-estado-puerto ocupado" aria-hidden="true"></i><strong>@switchResumen.PuertosOcupados</strong> ocupados</span>
                    <span><i class="indicador-estado-puerto libre" aria-hidden="true"></i><strong>@switchResumen.PuertosLibres</strong> libres confirmados</span>
                    <span><i class="indicador-estado-puerto desconocido" aria-hidden="true"></i><strong>@switchResumen.PuertosDesconocidos</strong> desconocidos</span>
                </div>
                <p class="conteo-puertos-switch">Interfaces documentadas: @switchResumen.TotalPuertos</p>
                <div class="destinos-switch-puertos">
                    <h3>Equipos y destinos registrados</h3>
                    @if (switchResumen.DestinosDocumentados.Count == 0)
                    {
                        <p>No hay destinos registrados en las relaciones de sus puertos.</p>
                    }
                    else
                    {
                        <ul>
                            @* destino muestra el texto remoto tal como se conoce en las relaciones guardadas. *@
                            @foreach (var destino in switchResumen.DestinosDocumentados)
                            {
                                <li>@destino</li>
                            }
                        </ul>
                    }
                </div>
                <footer class="acciones-switch-puertos">
                    <a class="boton" asp-controller="Topologia" asp-action="Detalle" asp-route-identificador="@switchResumen.Identificador">Editar puertos</a>
                    <a class="boton boton-secundario" asp-action="CrearInterfaz" asp-route-identificadorEquipo="@switchResumen.Identificador">Agregar puerto</a>
                </footer>
            </article>
        }
    </section>
}

