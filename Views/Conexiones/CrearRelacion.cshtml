@model ProyectoConexionRed.Web.Models.NuevaConexionDocumentadaViewModel
@{
    ViewData["Title"] = "Registrar conexión documental";
}

<section class="panel-formulario panel-formulario-ancho">
    <p class="sobrelinea">FUENTE VISIO · EXTREMO REMOTO OPCIONAL</p>
    <h1>Registrar una relación documentada</h1>
    <p>Usa esta opción cuando la fuente identifique el puerto local pero no permita confirmar el puerto remoto. Los datos faltantes quedan vacíos y el medio inicia como «No confirmado».</p>
    <form asp-action="CrearRelacion" method="post">
        <input asp-for="IdentificadorEquipoRetorno" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="mensaje-error"></div>
        <div class="grupo-formulario">
            <label asp-for="IdentificadorPuertoLocal">Puerto local conocido</label>
            @if (Model.IdentificadorPuertoLocal > 0)
            {
                <p class="ayuda-formulario">Puerto preseleccionado desde el frontal del switch; verifica que sea el correcto.</p>
            }
            <select asp-for="IdentificadorPuertoLocal" asp-items="Model.InterfacesDisponibles">
                <option value="0">Selecciona equipo y puerto</option>
            </select>
            <span asp-validation-for="IdentificadorPuertoLocal" class="mensaje-error"></span>
        </div>
        <fieldset class="grupo-formulario">
            <legend>Extremo remoto (opcional)</legend>
            <label asp-for="IdentificadorEquipoRemoto">Equipo ya inventariado</label>
            <select asp-for="IdentificadorEquipoRemoto" asp-items="Model.EquiposRemotosDisponibles">
                <option value="">No seleccionar un equipo inventariado</option>
            </select>
            <span asp-validation-for="IdentificadorEquipoRemoto" class="mensaje-error"></span>
            <small class="ayuda-formulario">Al elegir un equipo registrado, se usarán su nombre e IP guardados. Para un switch a switch, registra ambos puertos como enlace físico.</small>
            <label asp-for="EquipoRemoto">Nombre manual (si no está inventariado)</label><input asp-for="EquipoRemoto" /><span asp-validation-for="EquipoRemoto" class="mensaje-error"></span>
            <label asp-for="IpRemota">IP</label><input asp-for="IpRemota" /><span asp-validation-for="IpRemota" class="mensaje-error"></span>
            <label asp-for="PuertoRemoto">Puerto</label><input asp-for="PuertoRemoto" /><span asp-validation-for="PuertoRemoto" class="mensaje-error"></span>
        </fieldset>
        <div class="grupo-formulario">
            <label asp-for="Medio">Medio</label>
            <select asp-for="Medio">
                <option>No confirmado</option><option>Cobre RJ45</option><option>Fibra</option><option>DAC</option><option>Otro</option>
            </select>
            <span asp-validation-for="Medio" class="mensaje-error"></span>
        </div>
        <div class="grupo-formulario">
            <label asp-for="EstadoDatos">Estado de la información</label>
            <select asp-for="EstadoDatos">
                <option>A verificar</option><option>Pendiente de revisión</option><option>Confirmado</option><option>Desactualizado</option>
            </select>
            <span asp-validation-for="EstadoDatos" class="mensaje-error"></span>
        </div>
        <div class="grupo-formulario">
            <label asp-for="FechaUltimaRevision">Fecha de revisión (solo si se realizó)</label>
            <input asp-for="FechaUltimaRevision" type="date" /><span asp-validation-for="FechaUltimaRevision" class="mensaje-error"></span>
        </div>
        <fieldset class="grupo-formulario">
            <legend>Procedencia</legend>
            <label asp-for="FuentePagina">Página del Visio</label><input asp-for="FuentePagina" required />
            <span asp-validation-for="FuentePagina" class="mensaje-error"></span>
            <label asp-for="FuenteLibro">Libro Excel incrustado (opcional)</label><input asp-for="FuenteLibro" /><span asp-validation-for="FuenteLibro" class="mensaje-error"></span>
            <label asp-for="FuenteFila">Fila o referencia (opcional)</label><input asp-for="FuenteFila" /><span asp-validation-for="FuenteFila" class="mensaje-error"></span>
        </fieldset>
        <div class="grupo-formulario">
            <label asp-for="Observaciones">Notas</label>
            <textarea asp-for="Observaciones" rows="3"></textarea><span asp-validation-for="Observaciones" class="mensaje-error"></span>
        </div>
        <div class="acciones-formulario">
            <button class="boton" type="submit">Guardar relación</button>
            @if (Model.IdentificadorEquipoRetorno > 0)
            {
                <a class="boton boton-secundario" asp-controller="Topologia" asp-action="Detalle" asp-route-identificador="@Model.IdentificadorEquipoRetorno">Volver al switch</a>
            }
            else
            {
                <a class="boton boton-secundario" asp-action="Index">Cancelar</a>
            }
        </div>
    </form>
</section>
