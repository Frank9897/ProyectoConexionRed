@model ProyectoConexionRed.Web.Models.NuevaInterfazViewModel
@{
    ViewData["Title"] = "Registrar puerto";
}
<section class="panel-formulario panel-formulario-ancho">
    <p class="sobrelinea">DATOS PARA LA TOPOLOGÍA</p>
    <h1>Registrar una interfaz</h1>
    <p>Selecciona el equipo y documenta el puerto según la fuente disponible. No se consulta ni configura el dispositivo real.</p>
    <form asp-action="CrearInterfaz" method="post">
        <div asp-validation-summary="ModelOnly" class="mensaje-error"></div>
        <div class="rejilla-formulario">
            <div>
                <label asp-for="IdentificadorEquipo">Equipo</label>
                <select asp-for="IdentificadorEquipo" asp-items="Model.EquiposDisponibles"><option value="0">Selecciona un equipo</option></select>
                <span asp-validation-for="IdentificadorEquipo" class="mensaje-error"></span>
            </div>
            <div><label asp-for="EtiquetaPuerto">Etiqueta exacta del puerto</label><input asp-for="EtiquetaPuerto" placeholder="Ej.: 1, 24, SFP 1" /><span asp-validation-for="EtiquetaPuerto" class="mensaje-error"></span></div>
            <div>
                <label asp-for="TipoInterfaz">Tipo de interfaz</label>
                <select asp-for="TipoInterfaz">
                    <option>No confirmado</option><option>RJ45</option><option>SFP</option><option>SFP+</option><option>QSFP</option><option>Otro</option>
                </select>
                <span asp-validation-for="TipoInterfaz" class="mensaje-error"></span>
            </div>
            <div>
                <label asp-for="EstadoDatos">Estado del dato</label>
                <select asp-for="EstadoDatos">
                    <option>Pendiente de revisión</option><option>Confirmado</option><option>A verificar</option><option>Desactualizado</option>
                </select>
                <span asp-validation-for="EstadoDatos" class="mensaje-error"></span>
            </div>
            <div><label asp-for="FechaUltimaRevision">Fecha de última revisión</label><input asp-for="FechaUltimaRevision" type="date" /><span asp-validation-for="FechaUltimaRevision" class="mensaje-error"></span></div>
            <div class="campo-ancho"><label asp-for="Observaciones">Observaciones</label><textarea asp-for="Observaciones" rows="3"></textarea><span asp-validation-for="Observaciones" class="mensaje-error"></span></div>
        </div>
        <div class="acciones-formulario">
            <button class="boton" type="submit">Guardar puerto</button>
            <a class="boton boton-secundario" asp-action="Index">Cancelar</a>
        </div>
    </form>
</section>
