@model ProyectoConexionRed.Web.Models.NuevaInterfazViewModel
@{
    ViewData["Title"] = "Registrar puerto";
}
<section class="panel-formulario panel-formulario-ancho">
    <p class="sobrelinea">DATOS PARA LA TOPOLOGÍA</p>
    <h1>Registrar una interfaz</h1>
    <p>Selecciona el equipo y documenta el puerto según la fuente disponible. No se consulta ni configura el dispositivo real.</p>
    <form asp-action="CrearInterfaz" method="post">
        <div asp-validation-summary="ModelOnly" class="mensaje-error"></div>
        <partial name="_CamposInterfaz" model="Model" />
        <div class="acciones-formulario"><button class="boton" type="submit">Guardar puerto</button><a class="boton boton-secundario" asp-action="Index">Cancelar</a></div>
    </form>
</section>