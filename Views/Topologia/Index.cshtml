@model ProyectoConexionRed.Web.Models.TopologiaViewModel
@{
    ViewData["Title"] = "Topología";
}

<div class="hoja-impresion hoja-impresion-topologia" data-hoja-impresion>
<div class="contenido-hoja-impresion" data-contenido-impresion>
<section class="encabezado-pagina encabezado-topologia">
    <div>
        <p class="sobrelinea">MAPA DOCUMENTAL DE RED</p>
        <h1>Topología</h1>
        <p>Explora la infraestructura por capas. Cada relación se muestra según los datos documentados en el inventario.</p>
    </div>
    <div class="estado-fuente">
        <span class="punto-estado" aria-hidden="true"></span>
        <span>Vista de solo lectura</span>
    </div>
</section>

<section class="metricas-topologia" aria-label="Resumen de infraestructura">
    <article class="metrica-topologia">
        <span class="etiqueta-metrica">Equipos inventariados</span>
        <strong>@Model.TotalEquipos</strong>
        <small>Fichas documentales</small>
    </article>
    <article class="metrica-topologia">
            <span class="etiqueta-metrica">Switches clasificados</span>
        <strong>@Model.TotalSwitches</strong>
        <small>@Model.SwitchesInaccesibles con acceso administrativo inaccesible</small>
    </article>
    <article class="metrica-topologia">
        <span class="etiqueta-metrica">Puestos de usuario</span>
        <strong>@Model.TotalPuestos</strong>
        <small>@Model.PuestosConIp con IP documentada</small>
    </article>
    <article class="metrica-topologia">
        <span class="etiqueta-metrica">Enlaces completos</span>
        <strong>@Model.TotalEnlaces</strong>
        <small>@Model.RelacionesParciales.Count relaciones registradas desde puertos</small>
    </article>
</section>

<section class="capas-topologia" aria-label="Capas de la red">
    <article class="tarjeta-capa capa-fisica">
        <div class="cabecera-capa">
            <span class="numero-capa">01</span>
            <span class="etiqueta-capa">CAPA 1 · FÍSICA</span>
        </div>
        <h2>Puertos y medios</h2>
        <p>Interfaces, cableado y módulos ópticos documentados entre equipos.</p>
        <div class="dato-capa">
            <strong>@Model.TotalEnlaces</strong>
            <span>enlaces registrados</span>
        </div>
        <button class="enlace-capa boton-capa-topologia" type="button" data-seleccionar-capa="fisica">Ver detalle de capa <span aria-hidden="true">→</span></button>
    </article>

    <article class="tarjeta-capa capa-switching">
        <div class="cabecera-capa">
            <span class="numero-capa">02</span>
            <span class="etiqueta-capa">CAPA 2 · SWITCHING</span>
        </div>
        <h2>Switches y áreas</h2>
        <p>Switches inventariados y enlaces documentados entre switches. La administración y las VLAN quedan para otra etapa.</p>
        <div class="dato-capa">
            <strong>@Model.TotalSwitches</strong>
            <span>switches inventariados</span>
        </div>
        <button class="enlace-capa boton-capa-topologia" type="button" data-seleccionar-capa="switching">Ver switches <span aria-hidden="true">→</span></button>
    </article>

    <article class="tarjeta-capa capa-acceso">
        <div class="cabecera-capa">
            <span class="numero-capa">03</span>
            <span class="etiqueta-capa">CAPA 3 · ACCESO E IP</span>
        </div>
        <h2>Puestos y direcciones</h2>
        <p>PCs, impresoras y otros equipos finales asociados a puertos de switch.</p>
        <div class="dato-capa">
            <strong>@Model.PuestosConIp<span class="total-secundario"> / @Model.TotalPuestos</span></strong>
            <span>puestos con IP documentada</span>
        </div>
        <button class="enlace-capa boton-capa-topologia" type="button" data-seleccionar-capa="acceso">Ver puestos y switches enlazados <span aria-hidden="true">→</span></button>
    </article>
</section>

<aside class="nota-topologia">
    <span class="icono-nota" aria-hidden="true">i</span>
    <div>
        <strong>La topología es documental</strong>
        <p>No se realizan pings, consultas ni cambios sobre la red real. Cada línea representa una relación documentada; la vista distingue los extremos que la fuente no identifica.</p>
    </div>
</aside>

<section class="panel panel-grafico-topologia" id="mapa-grafico" aria-labelledby="titulo-mapa-topologia">
    <div class="encabezado-seccion-topologia">
        <div>
            <p class="sobrelinea">VISTA INTERACTIVA</p>
            <h2 id="titulo-mapa-topologia">Mapa de conexiones documentadas</h2>
            <p>Cada tarjeta es un equipo y cada línea una relación documentada; el puerto aparece junto a la línea cuando está identificado. Arrastra las tarjetas para reubicarlas: las líneas las siguen.</p>
        </div>
        <div class="acciones-topologia">
            <span class="contador-enlaces">@Model.Dispositivos.Count equipos · @Model.Enlaces.Count enlaces</span>
        </div>
    </div>

    <div class="filtros-topologia-grafica">
        <label>Buscar equipo
            <input type="search" data-busqueda-topologia placeholder="Nombre, modelo o IP" />
        </label>
        <label>Filtrar por área
            <select data-filtro-area>
                <option value="">Todas las áreas</option>
                @foreach (var area in Model.Areas)
                {
                    <option value="@area">@area</option>
                }
            </select>
        </label>
        <label data-etiqueta-filtro-switch hidden>Switch en foco
            <select data-filtro-switch>
                <option value="">Automático (el de más conexiones)</option>
                @foreach (var dispositivoSwitch in Model.Dispositivos.Where(d => (d.TipoDispositivo ?? string.Empty).Contains("switch", StringComparison.OrdinalIgnoreCase)).OrderBy(d => d.Nombre, StringComparer.OrdinalIgnoreCase))
                {
                    <option value="@dispositivoSwitch.Identificador">@dispositivoSwitch.Nombre</option>
                }
            </select>
        </label>
    </div>

    <div class="selector-capas-topologia" role="group" aria-label="Seleccionar vista de topología">
        <button type="button" class="selector-capa-topologia activa" data-seleccionar-capa="switching" aria-pressed="true" title="Solo los switches y las conexiones entre ellos">Entre switches</button>
        <button type="button" class="selector-capa-topologia" data-seleccionar-capa="acceso" aria-pressed="false" title="Un switch con sus equipos finales y los switches relacionados">Switch y sus equipos</button>
        <button type="button" class="selector-capa-topologia" data-seleccionar-capa="fisica" aria-pressed="false" title="Muestra todos los equipos del inventario; puede ser pesado">Inventario completo</button>
        <span data-resumen-mapa>@Model.Dispositivos.Count equipos · @Model.Enlaces.Count enlaces</span>
    </div>

    <div class="leyenda-topologia" aria-label="Leyenda de los puertos">
        <span><i class="muestra-puerto puerto-ocupado" aria-hidden="true"></i> Ocupado en la documentación</span>
        <span><i class="muestra-puerto puerto-libre" aria-hidden="true"></i> Libre confirmado</span>
        <span><i class="muestra-puerto puerto-desconocido" aria-hidden="true"></i> Desconocido</span>
        <span><i class="muestra-enlace capa-fisica" aria-hidden="true"></i> Capa 1 · Física</span>
        <span><i class="muestra-enlace capa-switching" aria-hidden="true"></i> Capa 2 · Switching</span>
        <span><i class="muestra-enlace capa-acceso" aria-hidden="true"></i> Capa 3 · Acceso</span>
        <span><i class="muestra-enlace enlace-parcial-switch" aria-hidden="true"></i> Uplink confirmado sin contraparte única</span>
        <span><i class="muestra-enlace enlace-pendiente" aria-hidden="true"></i> Relación pendiente de confirmar</span>
    </div>

    <p class="aclaracion-topologia-grafica">Capa 3 muestra PCs y equipos finales conectados al puerto local del switch. Capa 2 muestra enlaces entre switches y coteja ambas tablas para completar los dos puertos cuando se pueden emparejar. Capa 1 representa la infraestructura física. El Visio confirma las relaciones documentadas; esta vista no consulta la red en vivo.</p>

    <div class="marco-mapa-topologia" data-marco-mapa>
        <div class="barra-herramientas-mapa">
            <span class="ayuda-mapa-topologia">Arrastra una tarjeta para moverla · arrastra el fondo para desplazarte · Ctrl + rueda para acercar · «Ocultar» colapsa el grupo de un switch</span>
            <div class="acciones-mapa-topologia">
                <label class="control-zoom-mapa">Zoom
                    <input type="range" min="10" max="160" step="5" value="100" data-control-zoom aria-label="Nivel de zoom del mapa" />
                    <output class="nivel-zoom-mapa" data-nivel-zoom aria-live="polite">100 %</output>
                </label>
                <button class="boton boton-secundario" type="button" data-restablecer-mapa title="Borra posiciones guardadas y vuelve al esquema jerárquico inicial">Restablecer mapa</button>
                <button class="boton boton-secundario" type="button" data-ver-todo-mapa title="Encaja todas las tarjetas visibles en el área del mapa">Encajar vista</button>
                <button class="boton boton-secundario" type="button" data-maximizar-mapa aria-pressed="false" title="Expande el mapa dentro de esta página">Maximizar mapa</button>
                <button class="boton boton-secundario" type="button" data-imprimir-topologia title="Imprime la topología ajustada al papel">Imprimir mapa</button>
                <details class="herramientas-avanzadas-mapa">
                    <summary>Más opciones</summary>
                    <div class="contenido-herramientas-mapa">
                        <label class="control-solo-conectados" title="Oculta los equipos que no tienen ninguna conexión en la capa elegida">
                            <input type="checkbox" data-solo-conectados /> Solo equipos con conexión
                        </label>
                        <label class="selector-distribucion">Distribución
                            <select data-modo-distribucion title="Elige cómo se reparten las tarjetas">
                                <option value="niveles" selected>Jerárquica por niveles (recomendada)</option>
                                <option value="mosaico">Mosaico</option>
                                <option value="filas">Árbol horizontal</option>
                                <option value="cuadricula">Cuadrícula por área</option>
                            </select>
                        </label>
                        <button class="boton boton-secundario" type="button" data-distribuir-mapa title="Reparte de nuevo las tarjetas visibles con la distribución elegida">Reorganizar</button>
                        <button class="boton boton-secundario" type="button" data-contraer-todo title="Reduce todas las tarjetas a su cabecera">Contraer tarjetas</button>
                        <button class="boton boton-secundario" type="button" data-expandir-todo title="Restaura el contenido de todas las tarjetas">Expandir tarjetas</button>
                        <button class="boton boton-secundario" type="button" data-colapsar-grupos title="Oculta los equipos finales que cuelgan de cada switch">Ocultar grupos</button>
                        <button class="boton boton-secundario" type="button" data-expandir-grupos title="Muestra de nuevo todos los equipos ocultos">Mostrar grupos</button>
                    </div>
                </details>
            </div>
        </div>
        <div class="mapa-topologia" data-mapa-topologia data-capa-actual="switching" role="region" aria-label="Mapa navegable de equipos y conexiones" tabindex="0">
            <div class="lienzo-topologia" data-lienzo-topologia>
                <svg class="capa-svg-enlaces" data-capa-enlaces aria-hidden="true"></svg>
        @if (Model.Dispositivos.Count == 0)
        {
            <div class="estado-vacio-conexiones"><strong>No hay equipos para dibujar</strong><p>Agrega fichas al inventario y aparecerán aquí.</p></div>
        }
        else
        {
            @* Cada tarjeta se posiciona de forma absoluta en el lienzo y se puede arrastrar de forma independiente. *@
            @foreach (var dispositivo in Model.Dispositivos)
            {
                <article class="nodo-dispositivo-topologia @(dispositivo.EsSwitch && (dispositivo.Puertos.Count >= 48 || (dispositivo.Modelo?.Contains("S4148U", StringComparison.OrdinalIgnoreCase) ?? false)) ? "nodo-switch-alta-densidad" : string.Empty)" data-dispositivo
                         tabindex="0"
                         role="group"
                         aria-label="@($"{dispositivo.Nombre}. Arrastra la tarjeta o usa las flechas del teclado para moverla.")"
                         data-identificador-dispositivo="@dispositivo.Identificador"
                         data-dispositivo-nombre="@dispositivo.Nombre"
                         data-dispositivo-tipo="@dispositivo.TipoDispositivo"
                         data-dispositivo-area="@dispositivo.Area"
                         data-dispositivo-modelo="@dispositivo.Modelo"
                         data-dispositivo-ip="@dispositivo.IpAdministracion">
                    <header class="cabecera-nodo-topologia">
                        <img src="@dispositivo.Icono" alt="" aria-hidden="true" />
                        <div>
                            <p class="sobrelinea">@(dispositivo.Area ?? "Área no indicada") · @dispositivo.TipoDispositivo</p>
                            <h3>@dispositivo.Nombre</h3>
                            <p class="detalle-nodo-topologia">@(dispositivo.Modelo ?? "Modelo no indicado")</p>
                        </div>
                    </header>
                    <dl class="datos-nodo-topologia">
                        <div><dt>IP</dt><dd>@(dispositivo.IpAdministracion ?? "No indicada")</dd></div>
                        <div><dt>Rol</dt><dd>@dispositivo.RolEnArea</dd></div>
                    </dl>
                    @if (dispositivo.EsSwitch)
                    {
                        <div class="estado-capacidad-topologia">
                            <span>@dispositivo.EstadoCapacidad</span>
                            @if (!string.IsNullOrWhiteSpace(dispositivo.FuentePerfil))
                            {
                                <a href="@dispositivo.FuentePerfil" target="_blank" rel="noopener noreferrer">Fuente del perfil</a>
                            }
                        </div>
                    }
                    @if (dispositivo.Puertos.Count > 0)
                    {
                        @if (dispositivo.EsSwitch)
                        {
                            @await Html.PartialAsync("_FrontalSwitch", dispositivo)
                            <a class="enlace-detalle-switch" asp-action="Detalle" asp-route-identificador="@dispositivo.Identificador">Ver puertos y enlaces <span aria-hidden="true">→</span></a>
                        }
                        else
                        {
                            <div class="panel-frontal-switch">
                                <strong>Interfaces registradas</strong>
                                <div class="rejilla-puertos-switch">
                                    @foreach (var puerto in dispositivo.Puertos)
                                    {
                                        <span class="puerto-topologia @puerto.ClaseVisual"
                                              data-identificador-interfaz="@puerto.IdentificadorInterfaz"
                                              title="@puerto.Etiqueta · @puerto.EstadoVisual · @puerto.Tipo@(puerto.DestinoConexion is null ? "" : " · " + puerto.DestinoConexion)">
                                            <span>@puerto.Etiqueta</span>
                                            <span class="solo-lectores-pantalla">@puerto.EstadoVisual</span>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (dispositivo.EsSwitch)
                    {
                        <p class="capacidad-sin-puertos">Capacidad no documentada; todavía no se pueden calcular posiciones.</p>
                    }
                </article>
            }
        }
                <svg class="capa-svg-enlaces capa-svg-enlaces-activos" data-capa-enlaces-activos aria-hidden="true"></svg>
            </div>
            <div class="mapa-sin-elementos" data-mapa-vacio hidden>
                <strong>Ningún equipo cumple los filtros</strong>
                <p>Cambia la vista, el área o la búsqueda. «Inventario completo» muestra todos los equipos.</p>
            </div>
        </div>
        <p class="estado-mapa-topologia solo-lectores-pantalla" data-estado-mapa role="status" aria-live="polite"></p>
    </div>

    <div class="metadatos-enlaces-topologia" hidden>
        @foreach (var enlace in Model.Enlaces)
        {
            <span data-enlace-topologia
                  data-equipo-origen="@enlace.IdentificadorEquipoOrigen"
                  data-equipo-destino="@enlace.IdentificadorEquipoDestino"
                  data-puerto-origen="@enlace.IdentificadorPuertoOrigen"
                  data-puerto-destino="@enlace.IdentificadorPuertoDestino"
                  data-capa-relacional="@enlace.CapaRelacional"
                  data-confirmado="@(enlace.Confirmado ? "true" : "false")"
                  data-etiqueta="@($"{enlace.EquipoOrigen} · Puerto {enlace.PuertoOrigen} → {enlace.EquipoDestino} · Puerto {enlace.PuertoDestino} · {enlace.Medio} · {enlace.EstadoDatos}")"></span>
        }
        @foreach (var relacion in Model.RelacionesParciales.Where(relacion =>
            relacion.IdentificadorEquipoRemoto.HasValue
            && (!relacion.IdentificadorRelacionReciproca.HasValue
                || relacion.Identificador < relacion.IdentificadorRelacionReciproca.Value)))
        {
            <span data-enlace-topologia
                  data-relacion-parcial="true"
                  data-equipo-origen="@relacion.IdentificadorEquipoLocal"
                  data-equipo-destino="@relacion.IdentificadorEquipoRemoto"
                  data-puerto-origen="@relacion.IdentificadorPuertoLocal"
                  data-puerto-destino="@relacion.IdentificadorPuertoRemoto"
                  data-capa-relacional="@relacion.CapaRelacional"
                  data-cotejo-reciproco="@(relacion.IdentificadorRelacionReciproca.HasValue ? "true" : "false")"
                  data-confirmado="true"
                  data-etiqueta="@relacion.EquipoLocal · Puerto @relacion.PuertoLocal → @(relacion.EquipoRemoto ?? "Equipo sin identificar") · Puerto remoto @(relacion.PuertoRemoto ?? "sin par recíproco")"></span>
        }
    </div>
</section>

@{
    var resumen = Model.Resumen;
    // Porcentaje devuelve el ancho entero de una barra; con total cero no dibuja nada.
    string Porcentaje(int parte, int total) => total <= 0 ? "0" : ((int)Math.Round(parte * 100.0 / total)).ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<section class="panel estado-red" aria-labelledby="titulo-estado-red">
    <div class="encabezado-seccion-topologia">
        <div>
            <p class="sobrelinea">ESTADO DE LA RED DOCUMENTADA</p>
            <h2 id="titulo-estado-red">Direcciones IP, administración y STP</h2>
        </div>
    </div>
    <p>Indicadores calculados desde el inventario; no se consulta la red real. El estado STP se documenta enlace por enlace desde el <a asp-controller="EditorTopologia" asp-action="Index">editor del mapa</a>.</p>

    <div class="rejilla-estado-red">
        @foreach (var red in resumen.Redes)
        {
            <article class="tarjeta-estado">
                <h3>IP de la red @red.Nombre</h3>
                <div class="barra-uso" role="img" aria-label="@red.EnUso en uso, @red.Reservadas reservadas, @red.EnConflicto en conflicto y @red.Libres libres de @red.Total">
                    <span class="barra-uso-asignada" style="width:@Porcentaje(red.EnUso, red.Total)%"></span>
                    <span class="barra-uso-reservada" style="width:@Porcentaje(red.Reservadas, red.Total)%"></span>
                    <span class="barra-uso-conflicto" style="width:@Porcentaje(red.EnConflicto, red.Total)%"></span>
                </div>
                <ul class="cifras-estado">
                    <li><strong>@red.EnUso</strong><span>en uso</span></li>
                    <li><strong>@red.Reservadas</strong><span>reservadas</span></li>
                    <li><strong>@red.EnConflicto</strong><span>en conflicto</span></li>
                    <li><strong>@red.Libres</strong><span>libres de @red.Total</span></li>
                </ul>
            </article>
        }
        <article class="tarjeta-estado">
            <h3>Conflictos y otras IP</h3>
            @if (resumen.IpEnConflicto.Count == 0)
            {
                <p class="estado-ok">No hay IP compartidas sin resolver@(resumen.IpConflictosJustificados > 0 ? $" ({resumen.IpConflictosJustificados} justificadas)" : string.Empty).</p>
            }
            else
            {
                <p>IP declaradas por más de un equipo, sin resolver (<a href="#conflictos">corregir o justificar</a>):</p>
                <ul class="lista-estado">
                    @foreach (var conflicto in resumen.IpEnConflicto.Take(8))
                    {
                        <li>@conflicto</li>
                    }
                </ul>
            }
            <p class="nota-estado">@resumen.IpFueraDeRango IP en uso fuera de 192.168.0.x y 192.168.1.x. @resumen.EquiposSinIp equipos sin IP y @resumen.EquiposSinMac sin MAC.</p>
        </article>

        <article class="tarjeta-estado">
            <h3>Switches y administración</h3>
            <ul class="cifras-estado">
                <li><strong>@resumen.TotalSwitches</strong><span>switches</span></li>
                <li><strong>@resumen.SwitchesAdministrables</strong><span>administrables</span></li>
                <li><strong>@resumen.SwitchesNoAdministrables</strong><span>no administrables</span></li>
                <li><strong>@resumen.SwitchesSinConfirmar</strong><span>sin confirmar</span></li>
            </ul>
            <p class="nota-estado">Un switch sin IP se considera no administrable y no tiene STP.</p>
        </article>

        <article class="tarjeta-estado tarjeta-estado-ancha">
            <h3>STP o RSTP documentado</h3>
            <ul class="cifras-estado">
                <li><strong>@resumen.SwitchesStpDocumentado</strong><span>switches con STP documentado</span></li>
                <li><strong>@resumen.SwitchesStpParcial</strong><span>con documentación parcial</span></li>
                <li><strong>@resumen.SwitchesStpSinDocumentar</strong><span>sin documentar</span></li>
                <li><strong>@resumen.SwitchesSinEnlacesCompletos</strong><span>sin enlaces completos</span></li>
            </ul>
            <p>@resumen.EnlacesStpDocumentado de @resumen.EnlacesCompletos enlaces completos tienen su estado STP documentado (@resumen.EnlacesStpSinDocumentar sin documentar).</p>
            <p>Enlaces que cierran un ciclo: <strong>@resumen.CiclosSinDocumentar</strong> sin documentar, <strong>@resumen.CiclosDocumentados</strong> ya documentados y <strong>@resumen.CiclosEnRelacionesParciales</strong> que solo existen como relación parcial (conviértelos en enlace completo para poder documentarlos).</p>
            @if (resumen.SwitchesPendientesStp.Count > 0)
            {
                <p>Switches con enlaces sin estado STP:</p>
                <ul class="lista-estado">
                    @foreach (var pendiente in resumen.SwitchesPendientesStp)
                    {
                        <li>@pendiente.Nombre: @pendiente.SinDocumentar de @pendiente.Enlaces enlaces sin documentar</li>
                    }
                </ul>
            }
            else if (resumen.EnlacesCompletos > 0)
            {
                <p class="estado-ok">Todos los enlaces completos tienen su estado STP documentado.</p>
            }
            <p class="nota-estado">Los switches sin enlaces completos tienen sus conexiones como relaciones parciales: se documenta su STP al dibujarlas como enlaces en el editor.</p>
        </article>

        <article class="tarjeta-estado">
            <h3>Conexiones y puertos</h3>
            <ul class="cifras-estado">
                <li><strong>@resumen.EnlacesCompletos</strong><span>enlaces completos</span></li>
                <li><strong>@resumen.EnlacesConfirmados</strong><span>confirmados</span></li>
                <li><strong>@resumen.RelacionesParciales</strong><span>relaciones parciales</span></li>
                <li><strong>@resumen.RelacionesSinEquipo</strong><span>sin equipo asociado</span></li>
            </ul>
            <div class="barra-uso" role="img" aria-label="@resumen.PuertosConEnlace puertos con enlace, @resumen.PuertosConRelacionParcial con relación parcial y @resumen.PuertosSinDocumentar sin documentar">
                <span class="barra-uso-asignada" style="width:@Porcentaje(resumen.PuertosConEnlace, resumen.PuertosTotal)%"></span>
                <span class="barra-uso-reservada" style="width:@Porcentaje(resumen.PuertosConRelacionParcial, resumen.PuertosTotal)%"></span>
            </div>
            <p class="nota-estado">De @resumen.PuertosTotal puertos: @resumen.PuertosConEnlace con enlace completo, @resumen.PuertosConRelacionParcial con relación parcial y @resumen.PuertosSinDocumentar sin conexión documentada.</p>
        </article>
    </div>
</section>

@{
    var conflictos = Model.Conflictos;
    // TituloConflicto redacta el encabezado de cada tarjeta según el tipo de valor repetido.
    string TituloConflicto(ConflictoDetectado detectado) => detectado.Tipo switch
    {
        ConflictosViewModel.TipoIp => $"IP {detectado.Clave} declarada en {detectado.Equipos.Count} fichas",
        ConflictosViewModel.TipoMac => $"MAC {detectado.Clave} repetida en {detectado.Equipos.Count} fichas",
        _ => $"Nombre «{detectado.Equipos[0].Nombre}» repetido en {detectado.Equipos.Count} fichas"
    };
    // Orientacion ayuda a decidir entre corregir y justificar.
    string Orientacion(string claseConflicto) => claseConflicto switch
    {
        ConflictosViewModel.TipoIp => "Si son equipos distintos, cambia la IP de uno de ellos. Si es una IP compartida a propósito o el mismo equipo cargado dos veces, justifícalo.",
        ConflictosViewModel.TipoMac => "Una MAC no debería repetirse entre equipos distintos. Corrige o quita la MAC de la ficha equivocada; si es el mismo equipo con dos interfaces, justifícalo.",
        _ => "Dos fichas con el mismo nombre se confunden en el mapa y en las búsquedas. Renombra una; si es el mismo equipo duplicado, justifícalo hasta unificarlas."
    };
    string Marcador(string claseConflicto) => claseConflicto switch
    {
        ConflictosViewModel.TipoIp => "Nueva IP (vacío para quitarla)",
        ConflictosViewModel.TipoMac => "Nueva MAC (vacío para quitarla)",
        _ => "Nuevo nombre"
    };
}

<section class="panel conflictos-datos" id="conflictos" aria-labelledby="titulo-conflictos">
    <div class="encabezado-seccion-topologia">
        <div>
            <p class="sobrelinea">CONFLICTOS DE DATOS</p>
            <h2 id="titulo-conflictos">Corregir o justificar</h2>
        </div>
    </div>
    <p>Valores que figuran repetidos en fichas distintas. Cada conflicto se resuelve cambiando el dato de una ficha o justificando por qué es correcto que se repita; las justificaciones y los cambios quedan en el historial.</p>
    @if (TempData["MensajeConflictos"] is string mensajeConflictos)
    {
        <p class="estado-ok" role="status">@mensajeConflictos</p>
    }
    @if (TempData["ErrorConflictos"] is string errorConflictos)
    {
        <p class="aviso-campo aviso-campo-error" role="alert">@errorConflictos</p>
    }
    <p><strong>@conflictos.Pendientes.Count</strong> pendientes y <strong>@conflictos.Justificados.Count</strong> justificados.</p>

    @if (conflictos.Pendientes.Count == 0)
    {
        <p class="estado-ok">No hay conflictos pendientes de IP, MAC ni nombre.</p>
    }

    <datalist id="ips-libres-conflictos">
        @foreach (var ipLibre in conflictos.IpsLibres)
        {
            <option value="@ipLibre"></option>
        }
    </datalist>

    @foreach (var conflicto in conflictos.Pendientes)
    {
        <article class="tarjeta-conflicto">
            <h3>@TituloConflicto(conflicto)</h3>
            <p class="nota-estado">@Orientacion(conflicto.Tipo)</p>
            <ul class="equipos-conflicto">
                @foreach (var equipoConflicto in conflicto.Equipos)
                {
                    <li>
                        <div class="datos-equipo-conflicto">
                            <strong>@equipoConflicto.Nombre</strong>
                            <span>@equipoConflicto.Tipo@(string.IsNullOrWhiteSpace(equipoConflicto.Area) ? string.Empty : " · " + equipoConflicto.Area)</span>
                            <span>IP @(equipoConflicto.Ip ?? "sin dato") · MAC @(equipoConflicto.Mac ?? "sin dato")</span>
                            <a asp-controller="Inventario" asp-action="Editar" asp-route-id="@equipoConflicto.Identificador">Abrir ficha</a>
                        </div>
                        <form method="post" asp-controller="Conflictos" asp-action="Corregir" class="formulario-corregir">
                            <input type="hidden" name="tipo" value="@conflicto.Tipo" />
                            <input type="hidden" name="idEquipo" value="@equipoConflicto.Identificador" />
                            <input type="text" name="valor" placeholder="@Marcador(conflicto.Tipo)" aria-label="@Marcador(conflicto.Tipo) para @equipoConflicto.Nombre" list="@(conflicto.Tipo == ConflictosViewModel.TipoIp ? "ips-libres-conflictos" : null)" autocomplete="off" />
                            <button type="submit" class="boton boton-secundario">Cambiar</button>
                        </form>
                    </li>
                }
            </ul>
            <details class="justificar-conflicto">
                <summary>Justificar este conflicto</summary>
                <form method="post" asp-controller="Conflictos" asp-action="Justificar">
                    <input type="hidden" name="tipo" value="@conflicto.Tipo" />
                    <input type="hidden" name="valor" value="@conflicto.Clave" />
                    <label>Motivo
                        <select name="motivo">
                            @foreach (var motivo in ConflictosViewModel.MotivosPorTipo[conflicto.Tipo])
                            {
                                <option>@motivo</option>
                            }
                        </select>
                    </label>
                    <label>Explicación (obligatoria con «Otro»)
                        <textarea name="detalle" rows="2" maxlength="500"></textarea>
                    </label>
                    <button type="submit" class="boton">Guardar justificación</button>
                </form>
            </details>
        </article>
    }

    @if (conflictos.Justificados.Count > 0)
    {
        <details class="conflictos-justificados">
            <summary>Conflictos justificados (@conflictos.Justificados.Count)</summary>
            @foreach (var conflicto in conflictos.Justificados)
            {
                var justificacion = conflicto.Justificacion!;
                <article class="tarjeta-conflicto tarjeta-conflicto-justificado">
                    <h3>@TituloConflicto(conflicto)</h3>
                    <p>Motivo: <strong>@justificacion.Motivo</strong>@(string.IsNullOrWhiteSpace(justificacion.Detalle) ? string.Empty : ". " + justificacion.Detalle)</p>
                    <p class="nota-estado">Justificado por @justificacion.NombreUsuario el @justificacion.FechaUtc.ToString("dd/MM/yyyy HH:mm") UTC. Fichas: @string.Join(", ", conflicto.Equipos.Select(equipoConflicto => equipoConflicto.Nombre)).</p>
                    <form method="post" asp-controller="Conflictos" asp-action="Revocar">
                        <input type="hidden" name="tipo" value="@conflicto.Tipo" />
                        <input type="hidden" name="valor" value="@conflicto.Clave" />
                        <button type="submit" class="boton boton-secundario">Retirar la justificación</button>
                    </form>
                </article>
            }
        </details>
    }
</section>


</div>
</div>

<script src="~/js/paginacion-conexiones.js" asp-append-version="true"></script>
<script src="~/js/distribucion-red.js" asp-append-version="true"></script>
<script src="~/js/topologia-grafica.js" asp-append-version="true"></script>
