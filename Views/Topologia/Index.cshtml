@model ProyectoConexionRed.Web.Models.TopologiaViewModel
@{
    ViewData["Title"] = "Topología";
}

<section class="encabezado-pagina encabezado-topologia">
    <div>
        <p class="sobrelinea">MAPA DOCUMENTAL DE RED</p>
        <h1>Topología</h1>
        <p>Explora la infraestructura por capas. Cada relación se muestra según los datos documentados en el inventario.</p>
    </div>
    <div class="estado-fuente">
        <span class="punto-estado" aria-hidden="true"></span>
        <span>Vista de solo lectura</span>
    </div>
</section>

<section class="metricas-topologia" aria-label="Resumen de infraestructura">
    <article class="metrica-topologia">
        <span class="etiqueta-metrica">Equipos inventariados</span>
        <strong>@Model.TotalEquipos</strong>
        <small>Fichas documentales</small>
    </article>
    <article class="metrica-topologia">
            <span class="etiqueta-metrica">Switches clasificados</span>
        <strong>@Model.TotalSwitches</strong>
        <small>@Model.SwitchesInaccesibles con acceso administrativo inaccesible</small>
    </article>
    <article class="metrica-topologia">
        <span class="etiqueta-metrica">Puestos de usuario</span>
        <strong>@Model.TotalPuestos</strong>
        <small>@Model.PuestosConIp con IP documentada</small>
    </article>
    <article class="metrica-topologia">
        <span class="etiqueta-metrica">Enlaces completos</span>
        <strong>@Model.TotalEnlaces</strong>
        <small>@Model.RelacionesParciales.Count relaciones con extremo remoto pendiente</small>
    </article>
</section>

<section class="capas-topologia" aria-label="Capas de la red">
    <article class="tarjeta-capa capa-fisica">
        <div class="cabecera-capa">
            <span class="numero-capa">01</span>
            <span class="etiqueta-capa">CAPA 1 · FÍSICA</span>
        </div>
        <h2>Puertos y medios</h2>
        <p>Interfaces, cableado y módulos ópticos documentados entre equipos.</p>
        <div class="dato-capa">
            <strong>@Model.TotalEnlaces</strong>
            <span>enlaces registrados</span>
        </div>
        <button class="enlace-capa boton-capa-topologia" type="button" data-seleccionar-capa="fisica">Ver detalle de capa <span aria-hidden="true">→</span></button>
    </article>

    <article class="tarjeta-capa capa-switching">
        <div class="cabecera-capa">
            <span class="numero-capa">02</span>
            <span class="etiqueta-capa">CAPA 2 · SWITCHING</span>
        </div>
        <h2>Switches y áreas</h2>
        <p>Switches inventariados y enlaces documentados entre switches. La administración y las VLAN quedan para otra etapa.</p>
        <div class="dato-capa">
            <strong>@Model.TotalSwitches</strong>
            <span>switches inventariados</span>
        </div>
        <button class="enlace-capa boton-capa-topologia" type="button" data-seleccionar-capa="switching">Ver switches <span aria-hidden="true">→</span></button>
    </article>

    <article class="tarjeta-capa capa-acceso">
        <div class="cabecera-capa">
            <span class="numero-capa">03</span>
            <span class="etiqueta-capa">CAPA 3 · ACCESO E IP</span>
        </div>
        <h2>Puestos y direcciones</h2>
        <p>Puestos inventariados y switches conectados mediante un enlace registrado.</p>
        <div class="dato-capa">
            <strong>@Model.PuestosConIp<span class="total-secundario"> / @Model.TotalPuestos</span></strong>
            <span>puestos con IP documentada</span>
        </div>
        <button class="enlace-capa boton-capa-topologia" type="button" data-seleccionar-capa="acceso">Ver puestos y switches enlazados <span aria-hidden="true">→</span></button>
    </article>
</section>

<aside class="nota-topologia">
    <span class="icono-nota" aria-hidden="true">i</span>
    <div>
        <strong>La topología es documental</strong>
        <p>No se realizan pings, consultas ni cambios sobre la red real. Las conexiones solo aparecen cuando están registradas con sus extremos y puertos.</p>
    </div>
</aside>

<section class="panel panel-grafico-topologia" id="mapa-grafico" aria-labelledby="titulo-mapa-topologia">
    <div class="encabezado-seccion-topologia">
        <div>
            <p class="sobrelinea">VISTA INTERACTIVA</p>
            <h2 id="titulo-mapa-topologia">Mapa de conexiones documentadas</h2>
            <p>Selecciona una perspectiva para filtrar los equipos; las líneas aparecen solo entre extremos guardados.</p>
        </div>
        <div class="acciones-topologia">
            <span class="contador-enlaces">@Model.Dispositivos.Count equipos · @Model.Enlaces.Count enlaces</span>
            <button class="boton boton-secundario" type="button" data-imprimir-topologia>Imprimir vista</button>
        </div>
    </div>

    <div class="filtros-topologia-grafica">
        <label>Buscar equipo
            <input type="search" data-busqueda-topologia placeholder="Nombre, modelo o IP" />
        </label>
        <label>Filtrar por área
            <select data-filtro-area>
                <option value="">Todas las áreas</option>
                @foreach (var area in Model.Areas)
                {
                    <option value="@area">@area</option>
                }
            </select>
        </label>
    </div>

    <div class="selector-capas-topologia" role="group" aria-label="Seleccionar vista de topología">
        <button type="button" class="selector-capa-topologia activa" data-seleccionar-capa="fisica" aria-pressed="true">Capa 1 · Física</button>
        <button type="button" class="selector-capa-topologia" data-seleccionar-capa="switching" aria-pressed="false">Capa 2 · Switching</button>
        <button type="button" class="selector-capa-topologia" data-seleccionar-capa="acceso" aria-pressed="false">Capa 3 · Acceso</button>
        <span data-resumen-mapa>@Model.Dispositivos.Count equipos · @Model.Enlaces.Count enlaces</span>
    </div>

    <div class="leyenda-topologia" aria-label="Leyenda de los puertos">
        <span><i class="muestra-puerto puerto-ocupado" aria-hidden="true"></i> Ocupado en la documentación</span>
        <span><i class="muestra-puerto puerto-libre" aria-hidden="true"></i> Libre confirmado</span>
        <span><i class="muestra-puerto puerto-desconocido" aria-hidden="true"></i> Desconocido</span>
        <span><i class="muestra-enlace enlace-confirmado" aria-hidden="true"></i> Enlace confirmado</span>
        <span><i class="muestra-enlace enlace-parcial-switch" aria-hidden="true"></i> Uplink confirmado sin contraparte única</span>
        <span><i class="muestra-enlace enlace-parcial-switch" aria-hidden="true"></i> Switch documentado; contraparte sin tabla recíproca</span>
    </div>

    <p class="aclaracion-topologia-grafica">Capa 3 muestra PCs y equipos finales conectados al puerto local del switch. Capa 2 muestra enlaces entre switches y coteja ambas tablas para completar los dos puertos cuando se pueden emparejar. Capa 1 representa la infraestructura física. El Visio confirma las relaciones documentadas; esta vista no consulta la red en vivo.</p>

    <div class="mapa-topologia" data-mapa-topologia data-capa-actual="fisica">
        <svg class="capa-svg-enlaces" data-capa-enlaces aria-hidden="true"></svg>
        @if (Model.Dispositivos.Count == 0)
        {
            <div class="estado-vacio-conexiones"><strong>No hay equipos para dibujar</strong><p>Agrega fichas al inventario y aparecerán aquí.</p></div>
        }
        else
        {
            <div class="rejilla-dispositivos-topologia">
            @foreach (var dispositivo in Model.Dispositivos)
            {
                <article class="nodo-dispositivo-topologia" data-dispositivo
                         data-identificador-dispositivo="@dispositivo.Identificador"
                         data-dispositivo-nombre="@dispositivo.Nombre"
                         data-dispositivo-tipo="@dispositivo.TipoDispositivo"
                         data-dispositivo-area="@dispositivo.Area"
                         data-dispositivo-modelo="@dispositivo.Modelo"
                         data-dispositivo-ip="@dispositivo.IpAdministracion">
                    <header class="cabecera-nodo-topologia">
                        <img src="@dispositivo.Icono" alt="" aria-hidden="true" />
                        <div>
                            <p class="sobrelinea">@(dispositivo.Area ?? "Área no indicada") · @dispositivo.TipoDispositivo</p>
                            <h3>@dispositivo.Nombre</h3>
                            <p class="detalle-nodo-topologia">@(dispositivo.Modelo ?? "Modelo no indicado")</p>
                        </div>
                    </header>
                    <dl class="datos-nodo-topologia">
                        <div><dt>IP</dt><dd>@(dispositivo.IpAdministracion ?? "No indicada")</dd></div>
                        <div><dt>Rol</dt><dd>@dispositivo.RolEnArea</dd></div>
                    </dl>
                    @if (dispositivo.EsSwitch)
                    {
                        <div class="estado-capacidad-topologia">
                            <span>@dispositivo.EstadoCapacidad</span>
                            @if (!string.IsNullOrWhiteSpace(dispositivo.FuentePerfil))
                            {
                                <a href="@dispositivo.FuentePerfil" target="_blank" rel="noopener noreferrer">Fuente del perfil</a>
                            }
                        </div>
                    }
                    @if (dispositivo.Puertos.Count > 0)
                    {
                        @if (dispositivo.EsSwitch)
                        {
                            @await Html.PartialAsync("_FrontalSwitch", dispositivo)
                            <a class="enlace-detalle-switch" asp-action="Detalle" asp-route-identificador="@dispositivo.Identificador">Ver puertos y enlaces <span aria-hidden="true">→</span></a>
                        }
                        else
                        {
                            <div class="panel-frontal-switch">
                                <strong>Interfaces registradas</strong>
                                <div class="rejilla-puertos-switch">
                                    @foreach (var puerto in dispositivo.Puertos)
                                    {
                                        <span class="puerto-topologia @puerto.ClaseVisual"
                                              data-identificador-interfaz="@puerto.IdentificadorInterfaz"
                                              title="@puerto.Etiqueta · @puerto.EstadoVisual · @puerto.Tipo@(puerto.DestinoConexion is null ? "" : " · " + puerto.DestinoConexion)">
                                            <span>@puerto.Etiqueta</span>
                                            <span class="solo-lectores-pantalla">@puerto.EstadoVisual</span>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (dispositivo.EsSwitch)
                    {
                        <p class="capacidad-sin-puertos">Capacidad no documentada; todavía no se pueden calcular posiciones.</p>
                    }
                </article>
            }
            </div>
        }
    </div>

    <div class="metadatos-enlaces-topologia" hidden>
        @foreach (var enlace in Model.Enlaces)
        {
            <span data-enlace-topologia
                  data-equipo-origen="@enlace.IdentificadorEquipoOrigen"
                  data-equipo-destino="@enlace.IdentificadorEquipoDestino"
                  data-puerto-origen="@enlace.IdentificadorPuertoOrigen"
                  data-puerto-destino="@enlace.IdentificadorPuertoDestino"
                  data-capa-relacional="@enlace.CapaRelacional"
                  data-confirmado="@(enlace.Confirmado ? "true" : "false")"
                  data-etiqueta="@($"{enlace.EquipoOrigen} · Puerto {enlace.PuertoOrigen} → {enlace.EquipoDestino} · Puerto {enlace.PuertoDestino} · {enlace.Medio} · {enlace.EstadoDatos}")"></span>
        }
        @foreach (var relacion in Model.RelacionesParciales.Where(relacion =>
            relacion.IdentificadorEquipoRemoto.HasValue
            && (!relacion.IdentificadorRelacionReciproca.HasValue
                || relacion.Identificador < relacion.IdentificadorRelacionReciproca.Value)))
        {
            <span data-enlace-topologia
                  data-relacion-parcial="true"
                  data-equipo-origen="@relacion.IdentificadorEquipoLocal"
                  data-equipo-destino="@relacion.IdentificadorEquipoRemoto"
                  data-puerto-origen="@relacion.IdentificadorPuertoLocal"
                  data-puerto-destino="@relacion.IdentificadorPuertoRemoto"
                  data-capa-relacional="@relacion.CapaRelacional"
                  data-cotejo-reciproco="@(relacion.IdentificadorRelacionReciproca.HasValue ? "true" : "false")"
                  data-confirmado="true"
                  data-etiqueta="@relacion.EquipoLocal · Puerto @relacion.PuertoLocal → @(relacion.EquipoRemoto ?? "Equipo sin identificar") · Puerto remoto @(relacion.PuertoRemoto ?? "sin par recíproco")"></span>
        }
    </div>
</section>

@if (Model.Enlaces.Count == 0)
{
    <section class="vacio-topologia" id="enlaces-fisicos">
        <div class="icono-vacio" aria-hidden="true">
            <svg viewBox="0 0 64 64" focusable="false">
                <rect x="5" y="10" width="20" height="15" rx="3"></rect>
                <rect x="39" y="39" width="20" height="15" rx="3"></rect>
                <path d="M25 17h8a8 8 0 0 1 8 8v6a8 8 0 0 0 8 8"></path>
                <circle cx="15" cy="18" r="1.5"></circle>
                <circle cx="49" cy="47" r="1.5"></circle>
            </svg>
        </div>
        <p class="sobrelinea">CAPA FÍSICA</p>
        <h2>No hay enlaces físicos con ambos puertos guardados</h2>
        <p>Las relaciones con switch o equipo final identificado se muestran en las capas 2 y 3. La vista no inventa el puerto de red de una PC.</p>
        <a class="boton boton-secundario" asp-controller="Inventario" asp-action="Index">Revisar inventario</a>
    </section>
}
else
{
    <section class="panel panel-enlaces" id="enlaces-fisicos">
        <div class="encabezado-seccion-topologia">
            <div>
                <p class="sobrelinea">CAPA 1 · DETALLE DE CONEXIONES</p>
                <h2>Enlaces físicos documentados</h2>
            </div>
            <div class="acciones-topologia">
                <span class="contador-enlaces">@Model.Enlaces.Count enlaces completos</span>
                <button class="boton boton-secundario" type="button" data-imprimir-topologia>Imprimir vista</button>
            </div>
        </div>
        <div class="lista-fichas-conexion listado-topologia-enlaces">
            @* enlace recorre relaciones completas y muestra los datos de los dos extremos existentes. *@
            @foreach (var enlace in Model.Enlaces)
            {
                <article class="ficha-conexion ficha-enlace" data-registro-paginable>
                    <div class="trayecto-enlace">
                        <div class="extremo-enlace">
                            <p class="identificador-secundario">ORIGEN</p>
                            <h3>@enlace.EquipoOrigen</h3>
                            <small class="ip-extremo-conexion">@(enlace.IpEquipoOrigen ?? "IP no indicada")</small>
                            <span class="puerto-extremo-conexion">Puerto @enlace.PuertoOrigen</span>
                        </div>
                        <span class="flecha-enlace" aria-hidden="true">→</span>
                        <div class="extremo-enlace">
                            <p class="identificador-secundario">DESTINO</p>
                            <h3>@enlace.EquipoDestino</h3>
                            <small class="ip-extremo-conexion">@(enlace.IpEquipoDestino ?? "IP no indicada")</small>
                            <span class="puerto-extremo-conexion">Puerto @enlace.PuertoDestino</span>
                        </div>
                        <span class="etiqueta-estado-conexion">@enlace.EstadoDatos</span>
                    </div>
                    @if ((enlace.EstadoDatos.Equals("Confirmado", StringComparison.OrdinalIgnoreCase)
                         || enlace.EstadoDatos.Equals("Vigente", StringComparison.OrdinalIgnoreCase))
                         && !string.IsNullOrWhiteSpace(enlace.Medio)
                         && !enlace.Medio.Equals("No confirmado", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="medio-confirmado-conexion">Medio confirmado: @enlace.Medio</span>
                    }
                    <details class="detalles-fuente-conexion">
                        <summary>Ver fecha y respaldo</summary>
                        <p>Revisión: @(enlace.FechaUltimaRevision?.ToString("dd/MM/yyyy") ?? "Sin fecha confirmada") · Fuente: @(enlace.Fuente ?? "No indicada")</p>
                    </details>
                </article>
            }
        </div>
    </section>
}

@if (Model.RelacionesParciales.Count > 0)
{
    <section class="panel panel-enlaces" data-paginador="relaciones-parciales-topologia" aria-labelledby="titulo-conexiones-parciales-topologia">
        <div class="encabezado-seccion-topologia">
            <div><p class="sobrelinea">EXTREMO REMOTO INCOMPLETO</p><h2 id="titulo-conexiones-parciales-topologia">Relaciones documentadas para revisar</h2></div>
            <div class="controles-paginacion">
                <label for="tamano-relaciones-topologia">Mostrar</label>
                <select id="tamano-relaciones-topologia" data-tamano-pagina aria-label="Cantidad de relaciones parciales por página">
                    <option value="10" selected>10</option><option value="20">20</option><option value="30">30</option><option value="0">Todas</option>
                </select>
                <span data-resumen-pagina aria-live="polite"></span>
                <button class="boton-paginacion" type="button" data-pagina-anterior aria-label="Página anterior">← Anterior</button>
                <button class="boton-paginacion" type="button" data-pagina-siguiente aria-label="Página siguiente">Siguiente →</button>
            </div>
        </div>
        <p class="aclaracion-topologia-grafica">Las relaciones del Visio se muestran por capa: equipos finales en Capa 3, enlaces entre switches en Capa 2 y patcheras o recorrido físico en Capa 1. En un equipo final se indica el puerto del switch; no hace falta un puerto remoto de PC.</p>
        <div class="lista-fichas-conexion listado-topologia-enlaces" data-lista-paginada>
            @* relacion conserva el puerto local y el extremo remoto parcial tal como aparece en la fuente. *@
            @foreach (var relacion in Model.RelacionesParciales)
            {
                <article class="ficha-conexion ficha-enlace" data-registro-paginable>
                    <div class="trayecto-enlace">
                        <div class="extremo-enlace">
                            <p class="identificador-secundario">@(relacion.CapaRelacional == "switching" ? "SWITCH LOCAL · CAPA 2" : relacion.CapaRelacional == "acceso" ? "SWITCH LOCAL · CAPA 3" : "EXTREMO LOCAL · CAPA 1")</p>
                            <h3>@relacion.EquipoLocal</h3>
                            <small class="ip-extremo-conexion">@(relacion.IpLocal ?? "IP no indicada")</small>
                            <span class="puerto-extremo-conexion">Puerto @relacion.PuertoLocal</span>
                        </div>
                        <span class="flecha-enlace flecha-confirmada" aria-hidden="true">→</span>
                        <div class="extremo-enlace">
                            <p class="identificador-secundario">@(relacion.CapaRelacional == "switching" ? "SWITCH REMOTO" : "USUARIO / EQUIPO FINAL / SERVICIO")</p>
                            <h3>@(relacion.EquipoRemoto ?? "No identificado")</h3>
                            <small class="ip-extremo-conexion">@(relacion.IpRemota ?? "IP no indicada")</small>
                            @if (relacion.CapaRelacional == "switching")
                            {
                                <span class="puerto-extremo-conexion">@(relacion.PuertoRemoto is null ? "Puerto remoto sin par único en las tablas" : $"Puerto {relacion.PuertoRemoto}")</span>
                            }
                        </div>
                        <span class="etiqueta-estado-conexion">@(relacion.CapaRelacional == "switching" ? "Capa 2 · Enlace entre switches" : relacion.CapaRelacional == "acceso" ? "Capa 3 · Equipo final" : "Capa 1 · Relación física") · @relacion.EstadoDatos</span>
                    </div>
                    @if ((relacion.EstadoDatos.Equals("Confirmado", StringComparison.OrdinalIgnoreCase)
                         || relacion.EstadoDatos.Equals("Vigente", StringComparison.OrdinalIgnoreCase))
                         && !string.IsNullOrWhiteSpace(relacion.Medio)
                         && !relacion.Medio.Equals("No confirmado", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="medio-confirmado-conexion">Medio confirmado: @relacion.Medio</span>
                    }
                    <details class="detalles-fuente-conexion">
                        <summary>Ver fuente y notas</summary>
                        <p>@relacion.FuentePagina · @(relacion.FuenteLibro ?? "Sin libro") · fila @(relacion.FuenteFila ?? "sin indicar")</p>
                        @if (!string.IsNullOrWhiteSpace(relacion.Observaciones))
                        {
                            <p>@relacion.Observaciones</p>
                        }
                    </details>
                </article>
            }
        </div>
    </section>
}

<script src="~/js/paginacion-conexiones.js" asp-append-version="true"></script>
<script src="~/js/topologia-grafica.js" asp-append-version="true"></script>
