@model ProyectoConexionRed.Web.Models.DispositivoTopologiaViewModel

@{
    // gruposPuertos separa conectores de distinto formato; cambiar el agrupamiento altera las filas del frontal.
    var gruposPuertos = Model.Puertos.GroupBy(puerto => puerto.Tipo).ToList();
    // puertosOcupados cuenta enlaces completos y relaciones locales guardadas.
    var puertosOcupados = Model.Puertos.Count(puerto => puerto.ClaseVisual == "puerto-ocupado");
    // puertosLibres cuenta únicamente posiciones con estado libre confirmado.
    var puertosLibres = Model.Puertos.Count(puerto => puerto.ClaseVisual == "puerto-libre");
    // puertosDesconocidos evita interpretar ausencia de registro como puerto libre.
    var puertosDesconocidos = Model.Puertos.Count(puerto => puerto.ClaseVisual == "puerto-desconocido");
    // puertosConTransceptorRj45 lista solo las bocas ocupadas cuyo módulo se documentó en el S4148U.
    var puertosConTransceptorRj45 = Model.Puertos.Where(puerto => puerto.ModuloInstalado == "Transceptor RJ45").ToList();
}

<div class="panel-frontal-switch">
    <div class="resumen-puertos-frontal" aria-label="Resumen del estado de puertos">
        <span class="resumen-puerto"><i class="indicador-estado-puerto ocupado" aria-hidden="true"></i><b>@puertosOcupados</b> ocupados</span>
        <span class="resumen-puerto"><i class="indicador-estado-puerto libre" aria-hidden="true"></i><b>@puertosLibres</b> libres confirmados</span>
        <span class="resumen-puerto"><i class="indicador-estado-puerto desconocido" aria-hidden="true"></i><b>@puertosDesconocidos</b> desconocidos</span>
    </div>
    @if (puertosConTransceptorRj45.Count > 0)
    {
        <p class="nota-transceptores-rj45"><strong>Transceptores RJ45 documentados:</strong> @string.Join(", ", puertosConTransceptorRj45.Select(puerto => puerto.Etiqueta)).</p>
    }
    <p class="estado-seleccion-puerto" data-mensaje-puerto role="status" aria-live="polite">Selecciona un puerto para consultar su destino documentado.</p>
    <div class="frontal-switch-scroll">
        <div class="frontal-switch-panel" role="group" aria-label="Frontal de puertos de @Model.Nombre">
            <div class="frontal-switch-cabecera">
                <strong>@Model.Nombre</strong>
                <small>@(Model.Modelo ?? "Modelo no indicado") · @Model.EstadoCapacidad</small>
            </div>
            @if (gruposPuertos.Count == 0)
            {
                <p class="capacidad-sin-puertos">Capacidad no documentada; no se generan bocas sin una cantidad conocida.</p>
            }
            @foreach (var grupoPuertos in gruposPuertos)
            {
                // puertosDelGrupo conserva el orden de etiquetas al ubicar números impares y pares.
                var puertosDelGrupo = grupoPuertos.ToList();
                <section class="grupo-frontal-puertos">
                    <span class="etiqueta-grupo-frontal">@(grupoPuertos.Key.Equals("No confirmado", StringComparison.OrdinalIgnoreCase) ? "Tipo de puerto no indicado" : grupoPuertos.Key)</span>
                    <div class="filas-frontal-puertos">
                        <div class="fila-frontal-puertos">
                            @for (var indiceGrupo = 0; indiceGrupo < puertosDelGrupo.Count; indiceGrupo += 2)
                            {
                                // puertoSuperior representa la boca impar en el orden registrado.
                                var puertoSuperior = puertosDelGrupo[indiceGrupo];
                                <span class="puerto-topologia puerto-frontal @puertoSuperior.ClaseVisual @(puertoSuperior.Tipo.Contains("SFP", StringComparison.OrdinalIgnoreCase) ? "puerto-sfp" : "")"
                                      data-identificador-interfaz="@puertoSuperior.IdentificadorInterfaz"
                                      data-etiqueta-puerto="@puertoSuperior.Etiqueta"
                                      data-puerto-topologia
                                      data-estado-puerto="@puertoSuperior.EstadoVisual"
                                      data-destino-puerto="@(puertoSuperior.DestinoConexion ?? "Sin destino documentado")"
                                      tabindex="0"
                                      role="button"
                                      aria-pressed="false"
                                      aria-label="@puertoSuperior.Etiqueta · @puertoSuperior.EstadoVisual · @(puertoSuperior.DestinoConexion ?? "Sin destino documentado")"
                                      title="@puertoSuperior.Etiqueta · @puertoSuperior.EstadoVisual · @puertoSuperior.Tipo@(puertoSuperior.ModuloInstalado is null ? "" : " · " + puertoSuperior.ModuloInstalado)@(puertoSuperior.DestinoConexion is null ? "" : " · " + puertoSuperior.DestinoConexion)">
                                    <span class="numero-puerto-frontal">@puertoSuperior.Etiqueta</span>
                                    <span class="solo-lectores-pantalla">@puertoSuperior.EstadoVisual@(puertoSuperior.DestinoConexion is null ? "" : " · " + puertoSuperior.DestinoConexion)</span>
                                </span>
                            }
                        </div>
                        <div class="fila-frontal-puertos">
                            @for (var indiceGrupo = 1; indiceGrupo < puertosDelGrupo.Count; indiceGrupo += 2)
                            {
                                // puertoInferior representa la boca par en el orden registrado.
                                var puertoInferior = puertosDelGrupo[indiceGrupo];
                                <span class="puerto-topologia puerto-frontal @puertoInferior.ClaseVisual @(puertoInferior.Tipo.Contains("SFP", StringComparison.OrdinalIgnoreCase) ? "puerto-sfp" : "")"
                                      data-identificador-interfaz="@puertoInferior.IdentificadorInterfaz"
                                      data-etiqueta-puerto="@puertoInferior.Etiqueta"
                                      data-puerto-topologia
                                      data-estado-puerto="@puertoInferior.EstadoVisual"
                                      data-destino-puerto="@(puertoInferior.DestinoConexion ?? "Sin destino documentado")"
                                      tabindex="0"
                                      role="button"
                                      aria-pressed="false"
                                      aria-label="@puertoInferior.Etiqueta · @puertoInferior.EstadoVisual · @(puertoInferior.DestinoConexion ?? "Sin destino documentado")"
                                      title="@puertoInferior.Etiqueta · @puertoInferior.EstadoVisual · @puertoInferior.Tipo@(puertoInferior.ModuloInstalado is null ? "" : " · " + puertoInferior.ModuloInstalado)@(puertoInferior.DestinoConexion is null ? "" : " · " + puertoInferior.DestinoConexion)">
                                    <span class="numero-puerto-frontal">@puertoInferior.Etiqueta</span>
                                    <span class="solo-lectores-pantalla">@puertoInferior.EstadoVisual@(puertoInferior.DestinoConexion is null ? "" : " · " + puertoInferior.DestinoConexion)</span>
                                </span>
                            }
                        </div>
                    </div>
                </section>
            }
        </div>
    </div>
</div>
