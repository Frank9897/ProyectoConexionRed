@model IReadOnlyList<ProyectoConexionRed.Web.Services.FichaInventario>
@{
    ViewData["Title"] = "Inventarios";
    @* identificadorActivo refleja la base seleccionada por el navegador; cambiar su valor cambia la ficha marcada en uso. *@
    var identificadorActivo = ViewBag.IdentificadorActivo as string ?? "catastro";
}

<section class="hero hero-seccion">
    <div>
        <p class="sobrelinea">BASES INDEPENDIENTES</p>
        <h1>Inventarios</h1>
        <p>Selecciona una base de datos o crea una nueva sede vacía. Cada inventario conserva sus propios equipos, puertos, conexiones e historial.</p>
    </div>
    <div class="inventario-contador"><strong>@Model.Count / 3</strong><span>bases utilizadas</span></div>
</section>

@if (TempData["AvisoInventario"] is string aviso)
{
    <div class="aviso aviso-exito" role="status">@aviso</div>
}
@if (TempData["ErrorInventario"] is string error)
{
    <div class="aviso aviso-error" role="alert">@error</div>
}

<section class="panel inventarios-panel" aria-labelledby="titulo-inventarios-disponibles">
    <div class="encabezado-seccion">
        <div>
            <p class="sobrelinea">SELECCIÓN ACTUAL</p>
            <h2 id="titulo-inventarios-disponibles">Bases disponibles</h2>
        </div>
        <span class="etiqueta-suave">@Model.Count de 3</span>
    </div>

    <div class="inventarios-lista">
        @foreach (var inventario in Model)
        {
            @* estaActivo indica qué tarjeta coincide con la selección guardada por el servidor. *@
            var estaActivo = inventario.Identificador == identificadorActivo;
            <article class="inventario-ficha @(estaActivo ? "inventario-ficha-activa" : string.Empty)">
                <div class="inventario-ficha-info">
                    <span class="inventario-indicador" aria-hidden="true"></span>
                    <div>
                        <h3>@inventario.Nombre</h3>
                        <p>@(inventario.EsPrincipal ? "Base actual de Catastro" : "Base SQLite independiente")</p>
                    </div>
                </div>
                @if (estaActivo)
                {
                    <span class="etiqueta-activa">En uso</span>
                }
                else
                {
                    <form asp-controller="Inventarios" asp-action="Seleccionar" method="post">
                        <input type="hidden" name="identificador" value="@inventario.Identificador" />
                        <input type="hidden" name="volverA" value="@Context.Request.Path" />
                        <button class="boton boton-secundario" type="submit">Usar este inventario</button>
                    </form>
                }
            </article>
        }
    </div>
</section>

@if (Model.Count < 3)
{
    <section class="panel crear-inventario-panel" aria-labelledby="titulo-crear-inventario">
        <div>
            <p class="sobrelinea">NUEVA SEDE</p>
            <h2 id="titulo-crear-inventario">Crear inventario vacío</h2>
            <p>Se preparará una base SQLite independiente con el esquema actual. No copiará los datos de Catastro ni consultará la red.</p>
        </div>
        <form asp-controller="Inventarios" asp-action="Crear" method="post" class="formulario-crear-inventario">
            <label for="nombre-inventario">Nombre de la sede o inventario</label>
            <div class="campo-crear-inventario">
                <input id="nombre-inventario" name="nombre" type="text" minlength="2" maxlength="60" required placeholder="Por ejemplo: Edificio Norte" />
                <button class="boton" type="submit">Crear vacío</button>
            </div>
        </form>
    </section>
    <section class="panel crear-inventario-panel" aria-labelledby="titulo-cargar-inventario">
        <div>
            <p class="sobrelinea">CARGA ASISTIDA</p>
            <h2 id="titulo-cargar-inventario">Cargar fichas desde CSV</h2>
            <p>Revisa los equipos y capacidades en una vista previa antes de crear una nueva base independiente.</p>
        </div>
        <a class="boton" asp-controller="Inventarios" asp-action="ImportarCsv">Preparar carga</a>
    </section>
}
else
{
    <p class="nota-limite-inventarios">Se alcanzó el máximo de tres inventarios.</p>
}
