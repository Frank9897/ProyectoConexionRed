@{
    ViewData["Title"] = "Inicio";
}

<section class="hero">
    <p class="sobrelinea">DOCUMENTACIÓN DE INFRAESTRUCTURA</p>
    <h1>La red, organizada y consultable.</h1>
    <p>Primer módulo disponible: inventario de equipos con IP, área, vigencia documental y estado de acceso.</p>
