@model ProyectoConexionRed.Web.Models.EditarInterfazViewModel
@{
    ViewData["Title"] = "Corregir puerto";
}
<section class="panel-formulario panel-formulario-ancho">
    <p class="sobrelinea">DATOS PARA LA TOPOLOGÍA</p>
    <h1>Corregir interfaz</h1>
    <p>Los cambios quedan en el inventario y el historial; no configuran el equipo real.</p>
    <form asp-action="EditarInterfaz" method="post">
        <input asp-for="Identificador" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="mensaje-error"></div>
        <partial name="~/Views/Conexiones/_CamposInterfaz.cshtml" model="Model" />
        <div class="acciones-formulario"><button class="boton" type="submit">Guardar corrección</button><a class="boton boton-secundario" asp-controller="Conexiones" asp-action="Index">Cancelar</a></div>
    </form>
</section>